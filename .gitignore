# Rust build artifacts
/target
**/*.rs.bk

# Runtime output (market data, features, logs, stats) — never commit captured data
/data/
/logs/
*.log

# Local config with real credentials (ship config.example.toml instead).
# Anchored to the repo root: .cargo/config.toml (jemalloc build config) must publish.
/config.toml
/config.toml.bak.*

# Dashboard build artifacts (regenerated by setup.sh / Docker)
dashboard/frontend/node_modules/
dashboard/frontend/dist/
**/.venv/
**/__pycache__/

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Secrets & backup cruft (never commit)
.env
**/.env

# Internal working notes (dev reference — not for publish)
INTERNAL_NOTES.md
HANDOVER.md
.m5/
