# Copy to .env and adjust. Everything here is optional — defaults work as-is.
# (Pairs, order-book speed, and the optional read-only API key live in config.toml.)

# Host directory to store captured data. Point this at a big disk —
# capture grows ~30-50 GB/day at all ~500 pairs / 500 ms.
# Leave unset (commented) to use a Docker-managed named volume instead.
# DATA_PATH=/mnt/bigdisk/binance

# Host port the dashboard is served on (the container serves API + UI on 8000).
DASHBOARD_PORT=3010
